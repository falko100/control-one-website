---
const footerLinks = {
  Product: [
    { label: 'Functies', href: '/features' },
    { label: 'Certificeringsproces', href: '/certificeringsproces' },
    { label: 'Prijzen', href: '/pricing' },
    { label: 'Beveiliging', href: '/beveiliging' },
  ],
  Frameworks: [
    { label: 'ISO 27001', href: '/iso-27001' },
    { label: 'ISO 9001', href: '/iso-9001' },
    { label: 'ISO 14001', href: '/iso-14001' },
    { label: 'ISO 45001', href: '/iso-45001' },
    { label: 'NEN 7510', href: '/nen-7510' },
    { label: 'NIS2', href: '/nis2' },
    { label: 'Meer frameworks', href: '/frameworks' },
  ],
  Bedrijf: [
    { label: 'Over ons', href: '/over-ons' },
    { label: 'Blog', href: '/blog' },
    { label: 'Kennisbank', href: '/kennis' },
    { label: 'Vacatures', href: '/vacatures' },
    { label: 'Contact', href: '/contact' },
  ],
  Juridisch: [
    { label: 'Privacybeleid', href: '/privacybeleid' },
    { label: 'Algemene voorwaarden', href: '/algemene-voorwaarden' },
    { label: 'Cookiebeleid', href: '/cookiebeleid' },
  ],
};
---

<footer class="text-white/70" style="background: linear-gradient(135deg, #4080cc 0%, #3a72c4 60%, #4d8fd8 100%)">
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 md:gap-12 mb-12">
      <div class="col-span-2 md:col-span-1">
        <img src="/logo-footer.svg" alt="Control One" class="h-7" />
        <div class="mt-4 text-xs text-white/65 space-y-0.5">
          <p>Control One B.V.</p>
          <p>Twekkeler Es 42</p>
          <p>7547 SM Enschede</p>
          <p>KvK: 99763877</p>
          <p>BTW: NL869122927B01</p>
        </div>
      </div>

      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">{title}</h4>
          <ul class="space-y-2">
            {links.map(link => (
              <li>
                <a href={link.href} class="text-sm hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>

          {title === 'Product' && (
            <a href="/faq" class="mt-4 flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 transition-colors">
              <svg class="w-5 h-5 shrink-0 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/></svg>
              <span class="text-sm font-semibold text-white leading-snug">Veelgestelde vragen</span>
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <p>&copy; {new Date().getFullYear()} Control One. Alle rechten voorbehouden.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-white transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
        </a>
        <a href="#" class="hover:text-white transition-colors" aria-label="X (Twitter)">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
