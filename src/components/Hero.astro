---
import { maat } from '../lib/schermafbeelding';

const shot = '/screenshots/portal-dashboard.png';

const normen = ['ISO 27001', 'ISO 9001', 'ISO 14001', 'ISO 45001', 'NEN 7510', 'NIS2', 'ISO 42001'];

// Drie signalen naast het dashboard. Het volledige scherm is op heroformaat
// niet te lezen; deze kaartjes wel, en ze dragen de kern van het verhaal.
const signalen = [
  { label: 'Coach', labelKleur: 'text-primary-500', titel: 'Stap 11 van 33', balk: 33 },
  { label: 'Afgerond', labelKleur: 'text-emerald-600', titel: 'ISO 9001', sub: '38 van 38 stappen', subKleur: 'text-emerald-700 font-semibold' },
  { label: 'Open acties', labelKleur: 'text-primary-500', titel: '9 taken', sub: 'met eigenaar en datum', subKleur: 'text-primary-900/55' },
];

const vertrouwen = [
  { tekst: 'Nederlands bedrijf \u00b7 EU-hosting', pad: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { tekst: 'Vastgelopen? Vraag het een ISO-expert', pad: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { tekst: 'Zelf implementeren, geen dure consultant', pad: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { tekst: 'Platform en templates in Nederlands en Engels', pad: 'M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 01-3.827-5.802' },
];
---

<section class="relative overflow-hidden" style="background: linear-gradient(160deg, #3468b8 0%, #4080cc 50%, #5090d8 100%);">

  <!-- Ambient glow orbs -->
  <!-- De gloedcirkels steken buiten de sectie uit. Zonder eigen wrapper telt dat
       mee voor de scrollbreedte, waardoor de browser bij het focussen van een
       knop de hele hero opzij scrolt en de inhoud verspringt. -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/2 w-[700px] h-[700px] bg-white/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-white/5 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] bg-accent-400/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6">

    <!-- ── Tekst, acties en het dashboard ── -->
    <div class="grid lg:grid-cols-[7fr_8fr] gap-10 lg:gap-14 items-center pt-28 sm:pt-32 pb-10">

      <!-- Tekst en acties -->
      <div>
        <h1 class="text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight text-white leading-[1.05]">
          Werken aan impact
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-primary-300">van ambitie naar ISO</span>
        </h1>

        <p class="mt-6 text-lg text-white/90 leading-relaxed max-w-lg">
          Van risicoanalyse tot certificering: Control One begeleidt jouw organisatie stap voor stap. Alles op &eacute;&eacute;n plek, voor iedereen begrijpelijk.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://app.control-one.nl/register" class="inline-flex items-center px-7 py-3.5 text-base font-semibold text-primary-950 bg-white hover:bg-primary-50 rounded-full transition-all shadow-xl shadow-black/25">
            Gratis starten &middot; 14 dagen
          </a>
          <a href="/quickscan" class="inline-flex items-center px-6 py-3.5 text-base font-semibold text-white border border-white/50 hover:bg-white/10 rounded-full transition-colors">
            Doe de gratis quickscan
          </a>
        </div>

        <div class="mt-7 flex flex-wrap gap-1.5">
          {normen.map((n) => (
            <a href={'/' + n.toLowerCase().replace(/\s+/g, '-')} class="px-2.5 py-1 text-[10px] font-bold tracking-widest rounded-full border border-white/50 bg-white/15 text-white hover:bg-white/30 hover:border-white transition-colors">{n}</a>
          ))}
        </div>
      </div>

      <!-- Het dashboard, met drie signalen ernaast -->
      <div class="relative pr-0 lg:pr-24">
        <div class="rounded-2xl overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.35)] ring-1 ring-white/20 bg-white">
          <div class="flex items-center gap-2 px-3 py-2 bg-slate-100 border-b border-slate-200">
            <span class="w-2 h-2 rounded-full bg-red-400/70"></span>
            <span class="w-2 h-2 rounded-full bg-amber-400/70"></span>
            <span class="w-2 h-2 rounded-full bg-green-400/70"></span>
          </div>
          <img src={shot} {...maat(shot)} alt="Het dashboard van Control One met voortgang per norm, taken en KPI's" class="w-full block" fetchpriority="high" />
        </div>

        <div class="mt-4 grid grid-cols-3 gap-2 lg:mt-0 lg:block lg:space-y-3 lg:absolute lg:right-0 lg:top-10 lg:w-48">
          {signalen.map((sg) => (
            <div class="rounded-xl bg-white shadow-[0_18px_40px_rgba(0,0,0,0.3)] border border-primary-100 px-3.5 py-3">
              <p class:list={['text-[10px] font-bold uppercase tracking-widest', sg.labelKleur]}>{sg.label}</p>
              <p class="text-sm font-bold text-primary-950">{sg.titel}</p>
              {sg.balk && (
                <div class="mt-1.5 h-1 rounded-full bg-primary-100 overflow-hidden">
                  <div class="h-full rounded-full" style={`width:${sg.balk}%;background:#196bd7`}></div>
                </div>
              )}
              {sg.sub && <p class:list={['text-[11px]', sg.subKleur]}>{sg.sub}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Vertrouwensstrip -->
    <div class="rounded-2xl border border-white/20 bg-white/10 backdrop-blur-sm">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-white/15 sm:divide-x">
        {vertrouwen.map((v) => (
          <div class="flex items-center gap-3 px-5 py-4">
            <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={v.pad}/>
              </svg>
            </span>
            <span class="text-sm font-medium text-white leading-snug">{v.tekst}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Logo marquee ── -->
    <div class="mt-10 pb-14">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-white/80 mb-7">Vertrouwd door organisaties in heel Nederland & België</p>
      <div class="relative overflow-hidden">

        <div class="logo-marquee-track flex items-center gap-14">
          <!-- Set 1 -->
          <img src="/logos/clients/Bidfood.png" alt="Bidfood" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/unica_1_Wzps3Y.png" alt="Unica" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/Logo_Moore_DRV.png" alt="Moore DRV" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/Logo-inQdo-nieuw.png" alt="inQdo" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/waterschap-rivierenland-logo1.png" alt="Waterschap Rivierenland" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/hofberger-logo-langwerpig-1920w-1920w.png" alt="Hofberger" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/OminesLogoBlue.png" alt="Omines" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/logo_innvolve@2x.png" alt="Innvolve" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/Caredate.png" alt="Caredate" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/jdn-logo.png" alt="JDN" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/1280px-AVROTROS_logo_2020.svg_.png" alt="AVROTROS" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/Actabyte-logo-op-wit.png" alt="Actabyte" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/De-Kenniskamers.png" alt="De Kenniskamers" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/Logo-IQPS3-2-met-wit-1.png" alt="IQPS" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <img src="/logos/clients/horizontal-for-white-background.png" alt="Klant" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" />
          <!-- Set 2 (duplicate for seamless loop) -->
          <img src="/logos/clients/Bidfood.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/unica_1_Wzps3Y.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/Logo_Moore_DRV.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/Logo-inQdo-nieuw.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/waterschap-rivierenland-logo1.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/hofberger-logo-langwerpig-1920w-1920w.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/OminesLogoBlue.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/logo_innvolve@2x.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/Caredate.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/jdn-logo.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/1280px-AVROTROS_logo_2020.svg_.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/Actabyte-logo-op-wit.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/De-Kenniskamers.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/Logo-IQPS3-2-met-wit-1.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
          <img src="/logos/clients/horizontal-for-white-background.png" alt="" class="logo-item h-9 w-auto object-contain max-w-[140px]" loading="lazy" aria-hidden="true" />
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .logo-marquee-track {
    width: max-content;
    animation: logo-scroll 45s linear infinite;
  }
  .logo-marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes logo-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .logo-item {
    filter: brightness(0) invert(1);
    opacity: 0.9;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }
  .logo-item:hover {
    opacity: 1;
  }
</style>
