---
import { maat } from '../lib/schermafbeelding';
// ── Galerij van portalmodules die nergens anders op de site in beeld komen ──
// De losse featurepagina's tonen de grote modules. Dit raster laat zien wat er
// daarnaast nog in de portal zit, met een opname per module. Elke tegel opent
// de opname in de lightbox, net als de andere screenshots op de site.

type Module = {
  titel: string;
  tekst: string;
  shot: string;
  alt: string;
};

const modules: Module[] = [
  {
    titel: 'Doelstellingen',
    tekst: 'Meetbare doelen met streefwaarde, huidige waarde en voortgang per doel.',
    shot: '/screenshots/portal-doelstellingen.png',
    alt: 'Kwaliteitsdoelstellingen in Control One met streefwaarde, huidige waarde en voortgang',
  },
  {
    titel: 'Risicoregister',
    tekst: 'Elk risico met context, dreiging, eigenaar en score, voor en na behandeling.',
    shot: '/screenshots/portal-risicoregister.png',
    alt: 'Het risicoregister in Control One met context, dreiging en risiconiveau per regel',
  },
  {
    titel: 'Risicobeoordelingen',
    tekst: 'Periodieke herbeoordeling van je risico’s, met oude en nieuwe inschatting naast elkaar.',
    shot: '/screenshots/portal-risicobeoordelingen.png',
    alt: 'Risicobeoordelingen in Control One met de oude en de nieuwe indicatie per risico',
  },
  {
    titel: 'Maatregelenstatus',
    tekst: 'De voortgang per thema, zodat je ziet waar de implementatie nog achterloopt.',
    shot: '/screenshots/portal-managementsysteem.png',
    alt: 'De status van het managementsysteem in Control One, per hoofdstuk uitgesplitst',
  },
  {
    titel: 'CPAR’s',
    tekst: 'Corrigerende en preventieve acties met bron, categorie en status.',
    shot: '/screenshots/portal-cpars.png',
    alt: 'Het CPAR-overzicht in Control One met bron, categorie en status per actie',
  },
  {
    titel: 'Niet-conformiteiten',
    tekst: 'Afwijkingen uit audits en klachten, met de gekoppelde corrigerende actie.',
    shot: '/screenshots/portal-nonconformiteiten.png',
    alt: 'Niet-conformiteiten in Control One met categorie, bron en verantwoordelijke',
  },
  {
    titel: 'Verbeterregister',
    tekst: 'Verbeterpunten die geen afwijking zijn, met indiener, prioriteit en status.',
    shot: '/screenshots/portal-verbeterregister.png',
    alt: 'Het verbeterregister in Control One met indiener, prioriteit en status',
  },
  {
    titel: 'Klachten',
    tekst: 'Klachten per kanaal, met behandelaar, doorlooptijd en afhandeling.',
    shot: '/screenshots/portal-klachten.png',
    alt: 'Het klachtenoverzicht in Control One met kanaal, status en toegewezen behandelaar',
  },
  {
    titel: 'Kansenregister',
    tekst: 'De kansen naast de risico’s, met omvang, haalbaarheid en streefdatum.',
    shot: '/screenshots/portal-kansenregister.png',
    alt: 'Het kansenregister in Control One met omvang, haalbaarheid en status per kans',
  },
  {
    titel: 'Context van de organisatie',
    tekst: 'Interne en externe issues die je managementsysteem beïnvloeden.',
    shot: '/screenshots/portal-context.png',
    alt: 'De contextanalyse in Control One met interne en externe issues per categorie',
  },
  {
    titel: 'Belanghebbenden',
    tekst: 'Wie er belang heeft, wat zij verwachten en welke eisen je overneemt.',
    shot: '/screenshots/portal-belanghebbenden.png',
    alt: 'Het belanghebbendenregister in Control One met behoeften en verwachtingen per partij',
  },
  {
    titel: 'Handboek',
    tekst: 'Je managementsysteem als lopend document, bewerkbaar in de portal zelf.',
    shot: '/screenshots/portal-handboek.png',
    alt: 'Het ISO 27001 handboek in Control One, bewerkbaar met een tekstverwerker in de portal',
  },
  {
    titel: 'Checklists',
    tekst: 'Terugkerende controles met voortgang per lijst.',
    shot: '/screenshots/portal-checklist.png',
    alt: 'Checklists in Control One met de voortgang per lijst',
  },
  {
    titel: 'Training & competenties',
    tekst: 'Wie welke training heeft gevolgd, hoe lang die geldig is en wat verloopt.',
    shot: '/screenshots/portal-training.png',
    alt: 'Training en competenties in Control One met geldigheidsduur per training',
  },
  {
    titel: 'Apparatuur',
    tekst: 'Middelen met keuringsdatum en onderhoud, inclusief wat er binnenkort verloopt.',
    shot: '/screenshots/portal-apparatuur.png',
    alt: 'Het apparatuurregister in Control One met keurings- en onderhoudsdatums',
  },
  {
    titel: 'Kwaliteitscultuur',
    tekst: 'Activiteiten die de cultuur versterken, met score en verantwoordelijke.',
    shot: '/screenshots/portal-kwaliteitscultuur.png',
    alt: 'Kwaliteitscultuuractiviteiten in Control One met type, score en verantwoordelijke',
  },
  {
    titel: 'Kennisbank',
    tekst: 'Uitleg bij elk onderdeel van de norm, doorzoekbaar vanuit de portal.',
    shot: '/screenshots/portal-kennisbank.png',
    alt: 'De kennisbank in Control One, met artikelen gegroepeerd per onderwerp',
  },
];

// Het scherm dat we op ware grootte tonen, staat al in de lijst hierboven.
const uitgelicht = modules.find((m) => m.titel === 'Risicoregister') ?? modules[0];
---

<section class="relative py-20 sm:py-24 bg-gradient-to-b from-white to-primary-50/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-16">
      <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">In de portal</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
        En daarnaast nog
        <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">zeventien registers</span>
      </h2>
      <p class="mt-4 text-lg text-primary-900/60 leading-relaxed">
        De grote modules staan hierboven. Dit is wat er verder nog in zit, zodat je niet halverwege
        je traject alsnog een losse spreadsheet nodig hebt.
      </p>
    </div>

    <!-- Een register op ware grootte. Zeventien schermen naast elkaar werden op
         280px zo klein dat er niets van te lezen viel; beter een scherm dat je
         wel kunt bekijken, met de rest als scanbare lijst eronder. -->
    <div class="max-w-4xl mx-auto mb-12 sm:mb-16">
      <div class="rounded-2xl overflow-hidden border border-primary-100 shadow-2xl shadow-primary-200/40 bg-white">
        <div class="flex items-center gap-3 px-4 py-2.5 bg-primary-50 border-b border-primary-100">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400/60"></span>
          </div>
          <div class="flex-1 flex justify-center">
            <div class="bg-white/80 rounded px-3 py-0.5 text-xs text-primary-400 border border-primary-100 truncate max-w-[240px]">
              app.control-one.nl / risicoregister
            </div>
          </div>
          <div class="w-10 sm:w-14"></div>
        </div>
        <img
          src={uitgelicht.shot} {...maat(uitgelicht.shot)}
          alt={uitgelicht.alt}
          class="w-full block cursor-zoom-in"
          loading="lazy"
          data-lightbox
        />
      </div>
      <p class="mt-3 text-center text-xs text-primary-900/50">
        Het risicoregister. Elk register hieronder werkt op dezelfde manier: filteren, sorteren en exporteren.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6 max-w-5xl mx-auto">
      {modules.map((m) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-5 h-5 rounded-full bg-accent-400/15 text-accent-500 flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          </span>
          <div>
            <h3 class="font-bold text-primary-950 text-sm leading-snug">{m.titel}</h3>
            <p class="mt-0.5 text-xs text-primary-900/60 leading-relaxed">{m.tekst}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
