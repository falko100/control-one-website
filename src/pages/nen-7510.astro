---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const chapters = [
  {
    number: '4',
    title: 'Context van de organisatie',
    description: 'Breng de context van je zorgorganisatie in kaart: welke zorg lever je, welke patientgegevens verwerk je en welke eisen stellen patienten, ketenpartners en toezichthouders.',
    vereist: 'Inzicht in interne en externe context, identificatie van belanghebbenden (patienten, IGJ, AP, zorgverzekeraars, ketenpartners) en een helder toepassingsgebied voor het ISMS.',
    documenten: ['Scope document', 'Contextanalyse', 'Register van belanghebbenden'],
    platform: 'Interactieve scopebepaling, contextanalyse-template toegespitst op zorgprocessen en een automatisch gegenereerd scope document.',
  },
  {
    number: '5',
    title: 'Leiderschap',
    description: 'Zorg voor aantoonbare betrokkenheid van bestuur en management bij informatiebeveiliging in de zorg. Stel beleid vast en beleg rollen en verantwoordelijkheden.',
    vereist: 'Managementcommitment aantonen, een informatiebeveiligingsbeleid vaststellen dat past bij de zorgcontext en rollen, verantwoordelijkheden en bevoegdheden toewijzen.',
    documenten: ['Informatiebeveiligingsbeleid', 'Functiebeschrijvingen', 'Verantwoordelijkheidsmatrix'],
    platform: 'Beleidsgenerator met goedkeuringsworkflow, verantwoordelijkheidsmatrix en rollenregister voor je ISMS-team.',
  },
  {
    number: '6',
    title: 'Planning',
    description: "Beoordeel risico's rond patientgegevens en zorgprocessen, stel doelen en plan wijzigingen.",
    vereist: "Risico's en kansen identificeren, een risicobeoordelingsproces uitvoeren dat rekening houdt met patientveiligheid en continuiteit van zorg, en doelstellingen vaststellen.",
    documenten: ['Risicobeoordelingsrapport', 'Risicobewerkingsplan', 'Doelstellingenregister'],
    platform: 'Geintegreerde risico-engine met zorgspecifieke risicocontexten zoals patientgegevens en medische apparatuur.',
  },
  {
    number: '7',
    title: 'Ondersteuning',
    description: 'Beheer middelen, competenties, bewustzijn, communicatie en gedocumenteerde informatie.',
    vereist: 'Voldoende middelen beschikbaar stellen, competenties borgen, beveiligingsbewustzijn creeren bij zorgprofessionals en gedocumenteerde informatie beheersen.',
    documenten: ['Competentiematrix', 'Bewustwordingsprogramma', 'Documentbeheerbeleid'],
    platform: 'Centraal documentbeheer, een trainingsmodule voor bewustwording van zorgmedewerkers en een competentieregister.',
  },
  {
    number: '8',
    title: 'Uitvoering',
    description: 'Implementeer je beveiligingsprocessen en beheersmaatregelen, inclusief de zorgspecifieke A9-maatregelen.',
    vereist: 'Operationele planning en beheersing, uitvoering van het risicobewerkingsplan en implementatie van de beheersmaatregelen uit de annex, aangevuld met de zorgspecifieke maatregelen.',
    documenten: ['Verklaring van Toepasselijkheid', 'Risicobehandelprocedures', 'Beleidsdocumenten per maatregel'],
    platform: 'Interactieve VvT-builder met de volledige annex inclusief A9, en directe koppeling tussen maatregelen en je risicoregister.',
  },
  {
    number: '9',
    title: 'Evaluatie van prestaties',
    description: 'Monitor, meet, analyseer en evalueer je ISMS-prestaties.',
    vereist: 'Monitoren en meten van ISMS-prestaties, een intern auditprogramma uitvoeren en directiebeoordelingen houden.',
    documenten: ['Auditplan & auditrapport', 'KPI-register', 'Directiebeoordelingsverslag'],
    platform: 'Gestructureerde auditworkflow met 8 auditvragenlijsten en 151 vragen die ook alle zorgspecifieke maatregelen dekken.',
  },
  {
    number: '10',
    title: 'Verbetering',
    description: 'Pak afwijkingen aan en streef naar continue verbetering van je ISMS.',
    vereist: 'Non-conformiteiten identificeren en corrigeren, corrigerende maatregelen treffen en continue verbetering documenteren.',
    documenten: ['Non-conformiteitenregister', 'Corrigerende maatregelenplan', 'Verbeterregister'],
    platform: 'Non-conformiteiten tracker, corrigerende maatregelenbeheer en verbeterdashboard voor structurele groei van je ISMS.',
  },
];

const a9Maatregelen = [
  { number: 'A9.1', title: 'Toegang tot patientgegevens op basis van behandelrelatie', description: 'Alleen zorgverleners met een behandelrelatie krijgen toegang tot het dossier.' },
  { number: 'A9.2', title: 'Logging van toegang tot patientgegevens', description: 'Elke inzage wordt vastgelegd conform NEN 7513.' },
  { number: 'A9.3', title: 'Controle en beoordeling van logging', description: 'Periodieke controle van logbestanden op onrechtmatige inzage.' },
  { number: 'A9.4', title: 'Noodtoegang tot het patientdossier', description: 'Een gecontroleerde break-glass-procedure voor noodsituaties.' },
  { number: 'A9.5', title: 'Inzage van de patient in logging en dossier', description: 'Patienten kunnen zien wie hun gegevens heeft geraadpleegd.' },
  { number: 'A9.6', title: 'Veilige elektronische uitwisseling van patientgegevens', description: 'Uitwisseling met ketenpartners conform NEN 7512.' },
  { number: 'A9.7', title: 'Beroepsgeheim en geheimhouding', description: 'Borging van het medisch beroepsgeheim in beleid en afspraken.' },
  { number: 'A9.8', title: 'Beveiliging van medische apparatuur en informatiesystemen', description: 'Medische apparatuur en systemen zoals het EPD aantoonbaar beveiligd.' },
  { number: 'A9.9', title: 'Pseudonimisering en anonimisering van patientgegevens', description: 'Gegevens waar mogelijk gepseudonimiseerd of geanonimiseerd.' },
  { number: 'A9.10', title: 'Secundair gebruik van patientgegevens', description: 'Voorwaarden voor gebruik voor onderzoek, kwaliteit en beleid.' },
  { number: 'A9.11', title: 'Continuiteit van zorgkritische systemen', description: 'Zorgverlening loopt door, ook bij uitval van systemen.' },
  { number: 'A9.12', title: 'Melding van datalekken en zorgspecifieke incidenten', description: 'Meldprocedures richting AP, IGJ en betrokken patienten.' },
];

const benefits = [
  { title: 'Bescherm patientgegevens', description: 'Een systematische aanpak voor de beveiliging van medische dossiers, van behandelrelatie tot logging en uitwisseling.' },
  { title: 'Voldoe aan wettelijke eisen', description: 'NEN 7510 wordt in de zorg wettelijk verwacht, onder meer via de Wabvpz en de AVG. Toezichthouders IGJ en AP toetsen erop.' },
  { title: 'Vertrouwen van patienten en partners', description: 'Toon zorgverzekeraars, ketenpartners en patienten aan dat informatiebeveiliging aantoonbaar op orde is.' },
  { title: 'Geen dubbel werk met ISO 27001', description: 'NEN 7510:2024 is uitgelijnd op ISO 27001:2022. Wie beide normen wil, bouwt in Control One op hetzelfde fundament.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Control One — NEN 7510 Software',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://control-one.nl/nen-7510',
  description: 'Implementeer NEN 7510:2024 zelf met Control One. Uitgelijnd op ISO 27001:2022, inclusief 12 zorgspecifieke A9-maatregelen, een coach met 36 stappen en 132 vooringevulde documenten.',
  featureList: [
    'Implementatiecoach voor NEN 7510:2024 (36 stappen)',
    'Volledige annex inclusief 12 zorgspecifieke A9-maatregelen',
    'Risicoanalyse met zorgspecifieke contexten',
    'Verklaring van Toepasselijkheid (VvT)',
    'Interne audit module met 151 auditvragen',
    '132 vooringevulde documenten en sjablonen',
    'Logging en veilige uitwisseling conform NEN 7513 en NEN 7512',
  ],
  offers: {
    '@type': 'Offer',
    price: '49.00',
    priceCurrency: 'EUR',
    url: 'https://control-one.nl/pricing',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://control-one.nl' },
    { '@type': 'ListItem', position: 2, name: 'Frameworks', item: 'https://control-one.nl/frameworks' },
    { '@type': 'ListItem', position: 3, name: 'ISO 27001 NEN 7510', item: 'https://control-one.nl/nen-7510' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wat is NEN 7510?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NEN 7510 is de Nederlandse norm voor informatiebeveiliging in de zorg. De actuele editie NEN 7510-1:2024 is uitgelijnd op ISO/IEC 27001:2022 en vult die aan met zorgspecifieke beheersmaatregelen rond patientgegevens, zoals toegang op basis van behandelrelatie, logging (NEN 7513) en veilige uitwisseling (NEN 7512).',
      },
    },
    {
      '@type': 'Question',
      name: 'Voor wie is NEN 7510 verplicht?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NEN 7510 wordt wettelijk verwacht van zorgaanbieders die patientgegevens elektronisch verwerken, onder meer via de Wabvpz en het Besluit elektronische gegevensverwerking door zorgaanbieders. De IGJ en de Autoriteit Persoonsgegevens toetsen erop. Ook leveranciers die met patientgegevens werken krijgen de norm vaak via inkoopeisen opgelegd.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wat is het verschil tussen NEN 7510 en ISO 27001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NEN 7510-1:2024 volgt dezelfde hoofdstukstructuur en annex als ISO/IEC 27001:2022, aangevuld met zorgspecifieke beheersmaatregelen voor patientgegevens, logging, noodtoegang, medische apparatuur en veilige uitwisseling. In Control One is deze aanvulling opgenomen als eigen groep A9 met 12 maatregelen. Wie beide normen wil combineren, doet het gedeelde werk maar een keer.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wat zijn NEN 7512 en NEN 7513?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NEN 7512 en NEN 7513 zijn aanvullende zorgnormen die bij NEN 7510 horen. NEN 7512 gaat over veilige elektronische uitwisseling van patientgegevens tussen zorgpartijen. NEN 7513 beschrijft de logging van toegang tot het patientdossier, zodat achteraf te herleiden is wie welke gegevens heeft ingezien.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kan ik me laten certificeren voor NEN 7510?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Certificerende instellingen toetsen zorgorganisaties tegen NEN 7510. Omdat de norm is uitgelijnd op ISO 27001 wordt certificering vaak gecombineerd met een ISO 27001-certificaat. Control One bouwt het dossier op dat de auditor verwacht: beleid, risicoanalyse, VvT, logging en interne audits.',
      },
    },
    {
      '@type': 'Question',
      name: 'Hoe lang duurt een NEN 7510-implementatie?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Voor een mkb-zorgorganisatie is 3 tot 6 maanden tot de externe audit realistisch. De implementatiecoach van Control One splitst het traject op in 36 concrete stappen, zodat je zonder externe consultant kunt certificeren.',
      },
    },
  ],
};
---

<Layout
  title="NEN 7510 Software — Informatiebeveiliging in de zorg | Control One"
  description="Implementeer NEN 7510:2024 zelf met Control One. Uitgelijnd op ISO 27001:2022, inclusief 12 zorgspecifieke A9-maatregelen, een coach met 36 stappen en 132 vooringevulde documenten."
  jsonLd={[schema, breadcrumbSchema, faqSchema]}
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative pt-32 pb-24 overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #2d5fa8 0%, #2554a0 60%, #2d5fa8 100%);"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent-400/10 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>

      <div class="relative max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

          <!-- Left: text content -->
          <div class="flex-1 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-xs font-semibold tracking-wide uppercase text-accent-400 bg-white/10 rounded-full backdrop-blur-sm">
              <span class="w-1.5 h-1.5 bg-accent-400 rounded-full"></span>
              Informatiebeveiliging in de zorg
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
              ISO 27001 NEN 7510
            </h1>
            <p class="mt-2 text-xl sm:text-2xl font-medium text-primary-200">
              De Nederlandse zorgnorm, uitgelijnd op ISO 27001
            </p>
            <p class="mt-6 text-lg text-primary-300/80 leading-relaxed">
              Implementeer een ISMS volgens NEN 7510-1:2024, van behandelrelatie en logging tot veilige uitwisseling van patientgegevens. Control One begeleidt je zorgorganisatie stap voor stap.
            </p>
            <div class="mt-10 flex flex-col sm:flex-row gap-4">
              <a href="https://app.control-one.nl/register" class="inline-flex items-center px-6 py-3 text-base font-semibold text-primary-900 bg-white hover:bg-primary-50 rounded-lg transition-all shadow-lg">
                Start met NEN 7510
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
              </a>
              <a href="/features" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white/90 hover:text-white border border-white/20 hover:border-white/40 rounded-lg transition-all">
                Bekijk alle functies
              </a>
            </div>
          </div>

          <!-- Right: product visual (browser-chrome screenshot) -->
          <div class="flex-shrink-0 w-full lg:w-[620px] max-w-full">
            <div class="relative">
              <div class="absolute -inset-6 sm:-inset-10 bg-gradient-to-tr from-accent-400/25 via-primary-500/15 to-accent-400/15 rounded-[40px] blur-3xl pointer-events-none"></div>
              <div class="relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/15 bg-primary-950">
                <div class="flex items-center gap-2 px-3 sm:px-4 py-2.5 bg-primary-900/90 border-b border-white/5">
                  <div class="flex gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70"></span>
                  </div>
                  <div class="flex-1 flex justify-center">
                    <div class="px-3 py-1 rounded-md bg-white/[0.06] border border-white/10 text-[10px] sm:text-[11px] text-white/60 font-mono truncate max-w-[260px] sm:max-w-none">
                      app.control-one.nl / nen-7510 / coach
                    </div>
                  </div>
                  <div class="w-10 sm:w-14"></div>
                </div>
                <img
                  src="/screenshots/portal-coach.png"
                  alt="Control One implementatiecoach: stap voor stap naar NEN 7510"
                  width="1600"
                  height="1000"
                  class="w-full block bg-white object-cover object-top"
                  style="aspect-ratio: 16 / 9;"
                  fetchpriority="high"
                  data-lightbox
                />
              </div>

              <div class="hidden md:flex absolute -left-3 lg:-left-6 top-12 lg:top-16 px-3.5 py-2.5 rounded-2xl bg-white/95 backdrop-blur-md shadow-2xl border border-white/40 items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-accent-100 text-accent-700 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-widest text-primary-500 leading-none">Voor de zorg</p>
                  <p class="mt-1 text-xs font-bold text-primary-950 leading-none">12 zorgmaatregelen (A9)</p>
                </div>
              </div>

              <div class="hidden md:flex absolute -bottom-4 right-3 lg:-bottom-5 lg:right-8 px-3.5 py-2.5 rounded-2xl bg-primary-950 shadow-2xl ring-1 ring-accent-400/40 items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-accent-400 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-widest text-accent-400/80 leading-none">Normdekking</p>
                  <p class="mt-1 text-xs font-bold text-white leading-none">100% NEN 7510-1:2024</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What is NEN 7510 -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Wat is NEN 7510?</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight mb-6">
              De norm voor <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">informatiebeveiliging in de zorg</span>
            </h2>
            <div class="text-primary-900/60 leading-relaxed space-y-4">
              <p>
                NEN 7510 is de Nederlandse norm voor informatiebeveiliging in de zorg. De editie NEN 7510-1:2024 volgt dezelfde structuur als ISO/IEC 27001:2022 en vult die aan met zorgspecifieke eisen: toegang op basis van behandelrelatie, logging van dossierinzage (NEN 7513) en veilige uitwisseling van patientgegevens (NEN 7512).
              </p>
              <p>
                Voor zorgaanbieders die patientgegevens elektronisch verwerken is de norm wettelijk verankerd, onder meer via de Wabvpz. Toezichthouders zoals de IGJ en de Autoriteit Persoonsgegevens toetsen erop, en zorgverzekeraars en ketenpartners vragen er steeds vaker aantoonbaar naar.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {benefits.map(b => (
              <div class="p-5 rounded-2xl bg-gradient-to-br from-primary-50 to-white border border-primary-100">
                <h3 class="font-semibold text-primary-950 mb-2 text-sm">{b.title}</h3>
                <p class="text-xs text-primary-900/50 leading-relaxed">{b.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Zo werkt het in de portal -->
    <section class="py-24 bg-gradient-to-b from-white to-primary-50/40">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-accent-600 mb-3">Het platform</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
            Zo werkt NEN 7510 <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">in Control One</span>
          </h2>
          <p class="mt-4 text-lg text-primary-900/60 leading-relaxed">
            Vier modules waarmee je zorgorganisatie het ISMS implementeert, beheert en aantoonbaar maakt richting auditor en toezichthouder.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 max-w-5xl mx-auto">

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-coach.png" alt="Implementatiecoach met 36 stappen voor NEN 7510" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-primary-700 shadow">Module · Coach</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Implementatiecoach (36 stappen)</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Van contextanalyse tot certificeringsaudit in 5 fasen, met per stap uitleg in gewone taal en directe koppeling naar de juiste documenten.</p>
            </div>
          </article>

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-risks.png" alt="Risicoanalyse met zorgspecifieke risicocontexten in Control One" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-accent-700 shadow">Module · Risicoanalyse</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Risicoanalyse voor de zorg</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Beoordeel risico's rond patientgegevens en medische apparatuur, kwantificeer impact en kans en koppel maatregelen direct aan de annex.</p>
            </div>
          </article>

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-soa.png" alt="Verklaring van Toepasselijkheid inclusief A9-maatregelen in Control One" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-amber-700 shadow">Module · VvT</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Verklaring van Toepasselijkheid</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Beheer de volledige annex inclusief de 12 zorgspecifieke A9-maatregelen in een overzicht, met motivering en link naar het bijbehorende beleid.</p>
            </div>
          </article>

