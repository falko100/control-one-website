---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const verplichtingen = [
  {
    label: 'Registratieplicht',
    title: 'Registreer je organisatie',
    description: 'Val je onder de wet, dan registreer je je organisatie zelf bij het NCSC. De coach begint daarom met de vraag of en hoe de Cyberbeveiligingswet op jouw organisatie van toepassing is.',
    icon: 'M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z',
  },
  {
    label: 'Zorgplicht',
    title: 'Tref passende maatregelen',
    description: 'Artikel 21 verplicht tot passende en evenredige maatregelen in tien categorieen, volgens een all-hazards-benadering. Het bestuur keurt de maatregelen goed en is er eindverantwoordelijk voor.',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    label: 'Meldplicht',
    title: 'Meld significante incidenten',
    description: 'Significante incidenten meld je binnen strikte termijnen: een vroegtijdige waarschuwing binnen 24 uur, een volledige melding binnen 72 uur en een eindverslag binnen een maand.',
    icon: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0',
  },
];

const categorieen = [
  { number: 'M1', title: 'Risicoanalyse en beveiliging van informatiesystemen', description: 'Beleid voor risicoanalyse en de beveiliging van netwerk- en informatiesystemen.' },
  { number: 'M2', title: 'Incidentenbehandeling', description: 'Detecteren, registreren en afhandelen van beveiligingsincidenten.' },
  { number: 'M3', title: 'Bedrijfscontinuiteit en crisisbeheer', description: 'Back-ups, noodherstel en crisisbeheer zodat de dienstverlening doorloopt.' },
  { number: 'M4', title: 'Beveiliging van de toeleveringsketen', description: 'Grip op de beveiliging van leveranciers en dienstverleners in de keten.' },
  { number: 'M5', title: 'Verwerving, ontwikkeling en onderhoud', description: 'Beveiligingseisen bij inkoop en ontwikkeling, inclusief kwetsbaarhedenbeheer.' },
  { number: 'M6', title: 'Effectiviteit van maatregelen beoordelen', description: 'Beleid en procedures om te toetsen of je maatregelen werken.' },
  { number: 'M7', title: 'Cyberhygiene en opleiding', description: 'Basispraktijken voor cyberhygiene en cybersecurityopleiding, ook voor het bestuur.' },
  { number: 'M8', title: 'Cryptografie en encryptie', description: 'Beleid voor het gebruik van cryptografie en versleuteling.' },
  { number: 'M9', title: 'Personeel, toegang en activa', description: 'Personeelsbeveiliging, toegangsbeleid en beheer van activa.' },
  { number: 'M10', title: 'Multifactorauthenticatie en beveiligde communicatie', description: 'MFA, beveiligde spraak-, video- en tekstcommunicatie en noodcommunicatie.' },
];

const meldplicht = [
  { termijn: '24 uur', title: 'Vroegtijdige waarschuwing', description: 'Meld binnen 24 uur na ontdekking of het incident vermoedelijk door onrechtmatig handelen komt en of er grensoverschrijdende gevolgen zijn.' },
  { termijn: '72 uur', title: 'Volledige incidentmelding', description: 'Binnen 72 uur volgt de volledige melding met een eerste beoordeling van ernst, impact en waar mogelijk indicatoren van aantasting.' },
  { termijn: '1 maand', title: 'Eindverslag', description: 'Uiterlijk een maand later lever je een eindverslag met oorzaak, getroffen maatregelen en eventuele grensoverschrijdende gevolgen.' },
];

const benefits = [
  { title: 'Voldoe aantoonbaar aan de wet', description: 'De Cyberbeveiligingswet geldt sinds 15 augustus 2026. Bouw het dossier op waarmee je je tegenover de toezichthouder verantwoordt.' },
  { title: 'Meldplicht op orde', description: 'Met een ingericht incidentproces haal je de termijnen van 24 uur, 72 uur en een maand zonder paniek.' },
  { title: 'Bestuur in positie', description: 'NIS2 legt de verantwoordelijkheid bij het bestuur. Control One maakt maatregelen en voortgang inzichtelijk op bestuursniveau.' },
  { title: 'Bouwt voort op ISO 27001', description: 'De tien maatregelcategorieen overlappen sterk met ISO 27001:2022. Heb je die norm al, dan is het meeste werk gedaan.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Control One — NIS2 Software',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://control-one.nl/nis2',
  description: 'Voldoe aan NIS2 en de Cyberbeveiligingswet met Control One. Registratie, zorgplicht met de tien maatregelcategorieen van artikel 21 en de meldplicht, stap voor stap geregeld.',
  featureList: [
    'Implementatiecoach voor NIS2 en de Cyberbeveiligingswet',
    'Toepasselijkheidscheck en registratie bij het NCSC',
    'Tien maatregelcategorieen van artikel 21',
    'Maatregelenverantwoording richting de toezichthouder',
    'Incidentproces voor de meldplicht (24 uur, 72 uur, 1 maand)',
    'Beveiliging van de toeleveringsketen',
    'Mapping naar ISO 27001:2022-maatregelen',
  ],
  offers: {
    '@type': 'Offer',
    price: '49.00',
    priceCurrency: 'EUR',
    url: 'https://control-one.nl/pricing',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://control-one.nl' },
    { '@type': 'ListItem', position: 2, name: 'Frameworks', item: 'https://control-one.nl/frameworks' },
    { '@type': 'ListItem', position: 3, name: 'NIS2', item: 'https://control-one.nl/nis2' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wat is NIS2 en wat is de Cyberbeveiligingswet?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NIS2 is de Europese richtlijn (EU) 2022/2555 voor netwerk- en informatiebeveiliging. In Nederland is de richtlijn ingevoerd met de Cyberbeveiligingswet, die op 15 augustus 2026 in werking is getreden. De wet verplicht organisaties in kritieke sectoren tot registratie, passende beveiligingsmaatregelen en het melden van significante incidenten.',
      },
    },
    {
      '@type': 'Question',
      name: 'Valt mijn organisatie onder NIS2?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'De wet geldt voor essentiele en belangrijke entiteiten in sectoren zoals energie, zorg, transport, digitale infrastructuur, industrie en overheid. Als vuistregel vallen middelgrote en grote organisaties in die sectoren eronder (vanaf 50 medewerkers of 10 miljoen euro omzet), maar ook kleinere organisaties met een kritieke rol kunnen aangewezen worden. Je bent zelf verantwoordelijk voor de toepasselijkheidscheck en registratie bij het NCSC. De coach in Control One begint precies daar.',
      },
    },
    {
      '@type': 'Question',
      name: 'Word ik gecertificeerd voor NIS2?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nee. Anders dan bij ISO-normen is NIS2 wetgeving: er bestaat geen NIS2-certificaat en je organisatie staat onder toezicht van een sectortoezichthouder. Je voldoet door passende maatregelen te treffen en die aantoonbaar te maken. In Control One bouw je daarvoor een maatregelenverantwoording op per categorie van artikel 21.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wat houdt de NIS2-meldplicht in?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Significante incidenten meld je bij het CSIRT (in Nederland het NCSC) en de toezichthouder in drie stappen: een vroegtijdige waarschuwing binnen 24 uur, een volledige incidentmelding binnen 72 uur en een eindverslag binnen een maand. Control One bevat het incidentproces en de procedures om deze termijnen te halen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wat zijn de tien maatregelcategorieen van artikel 21?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Artikel 21 lid 2 noemt tien categorieen: risicoanalyse en beveiliging van informatiesystemen, incidentenbehandeling, bedrijfscontinuiteit en crisisbeheer, beveiliging van de toeleveringsketen, beveiliging bij verwerving en ontwikkeling, beoordeling van de effectiviteit van maatregelen, cyberhygiene en opleiding, cryptografie, personeelsbeveiliging en toegangsbeleid, en multifactorauthenticatie met beveiligde communicatie.',
      },
    },
    {
      '@type': 'Question',
      name: 'Ik heb al ISO 27001. Wat betekent NIS2 voor mij?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Goed nieuws: de tien maatregelcategorieen van NIS2 overlappen sterk met de beheersmaatregelen van ISO 27001:2022. In Control One is per NIS2-maatregel de overeenkomstige ISO 27001-maatregel aangegeven, zodat je bestaande documentatie direct kunt koppelen. Aanvullend regel je vooral de registratie, de meldplicht-termijnen en de bestuursverantwoordelijkheid.',
      },
    },
  ],
};
---

<Layout
  title="NIS2 Software — Cyberbeveiligingswet | Control One"
  description="Voldoe aan NIS2 en de Cyberbeveiligingswet met Control One. Registratie bij het NCSC, de tien maatregelcategorieen van artikel 21 en de meldplicht van 24 uur, 72 uur en een maand, stap voor stap geregeld."
  jsonLd={[schema, breadcrumbSchema, faqSchema]}
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative pt-32 pb-24 overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #2d5fa8 0%, #2554a0 60%, #2d5fa8 100%);"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent-400/10 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>

      <div class="relative max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

          <!-- Left: text content -->
          <div class="flex-1 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-xs font-semibold tracking-wide uppercase text-accent-400 bg-white/10 rounded-full backdrop-blur-sm">
              <span class="w-1.5 h-1.5 bg-accent-400 rounded-full"></span>
              Cyberbeveiligingswet
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
              NIS2
            </h1>
            <p class="mt-2 text-xl sm:text-2xl font-medium text-primary-200">
              Netwerk- en informatiebeveiliging als wettelijke plicht
            </p>
            <p class="mt-6 text-lg text-primary-300/80 leading-relaxed">
              De Cyberbeveiligingswet geldt sinds 15 augustus 2026. Control One leidt je van de toepasselijkheidscheck en NCSC-registratie langs de tien maatregelcategorieen van artikel 21, met de meldplicht aantoonbaar ingericht.
            </p>
            <div class="mt-10 flex flex-col sm:flex-row gap-4">
              <a href="https://app.control-one.nl/register" class="inline-flex items-center px-6 py-3 text-base font-semibold text-primary-900 bg-white hover:bg-primary-50 rounded-lg transition-all shadow-lg">
                Start met NIS2
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
              </a>
              <a href="/features" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white/90 hover:text-white border border-white/20 hover:border-white/40 rounded-lg transition-all">
                Bekijk alle functies
              </a>
            </div>
          </div>

          <!-- Right: product visual (browser-chrome screenshot) -->
          <div class="flex-shrink-0 w-full lg:w-[620px] max-w-full">
            <div class="relative">
              <div class="absolute -inset-6 sm:-inset-10 bg-gradient-to-tr from-accent-400/25 via-primary-500/15 to-accent-400/15 rounded-[40px] blur-3xl pointer-events-none"></div>
              <div class="relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/15 bg-primary-950">
                <div class="flex items-center gap-2 px-3 sm:px-4 py-2.5 bg-primary-900/90 border-b border-white/5">
                  <div class="flex gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70"></span>
                  </div>
                  <div class="flex-1 flex justify-center">
                    <div class="px-3 py-1 rounded-md bg-white/[0.06] border border-white/10 text-[10px] sm:text-[11px] text-white/60 font-mono truncate max-w-[260px] sm:max-w-none">
                      app.control-one.nl / nis2 / coach
                    </div>
                  </div>
                  <div class="w-10 sm:w-14"></div>
                </div>
                <img
                  src="/screenshots/portal-coach.png"
                  alt="Control One implementatiecoach voor NIS2 en de Cyberbeveiligingswet"
                  width="1600"
                  height="1000"
                  class="w-full block bg-white object-cover object-top"
                  style="aspect-ratio: 16 / 9;"
                  fetchpriority="high"
                  data-lightbox
                />
              </div>

              <div class="hidden md:flex absolute -left-3 lg:-left-6 top-12 lg:top-16 px-3.5 py-2.5 rounded-2xl bg-white/95 backdrop-blur-md shadow-2xl border border-white/40 items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-accent-100 text-accent-700 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-widest text-primary-500 leading-none">Meldplicht</p>
                  <p class="mt-1 text-xs font-bold text-primary-950 leading-none">24 uur · 72 uur · 1 maand</p>
                </div>
              </div>

              <div class="hidden md:flex absolute -bottom-4 right-3 lg:-bottom-5 lg:right-8 px-3.5 py-2.5 rounded-2xl bg-primary-950 shadow-2xl ring-1 ring-accent-400/40 items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-accent-400 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-widest text-accent-400/80 leading-none">Zorgplicht</p>
                  <p class="mt-1 text-xs font-bold text-white leading-none">10 maatregelcategorieen</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What is NIS2 -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Wat is NIS2?</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight mb-6">
              Geen norm, maar <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">wetgeving</span>
            </h2>
            <div class="text-primary-900/60 leading-relaxed space-y-4">
              <p>
                NIS2 is de Europese richtlijn voor netwerk- en informatiebeveiliging, in Nederland ingevoerd met de Cyberbeveiligingswet. Anders dan bij een ISO-norm word je niet gecertificeerd: je staat onder toezicht van een sectortoezichthouder en moet zelf aantonen dat je beveiliging op orde is.
              </p>
              <p>
                De wet kent drie kernverplichtingen: registratie bij het NCSC, een zorgplicht met tien categorieen beveiligingsmaatregelen en een meldplicht voor significante incidenten. Het bestuur is eindverantwoordelijk en moet de maatregelen goedkeuren.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {benefits.map(b => (
              <div class="p-5 rounded-2xl bg-gradient-to-br from-primary-50 to-white border border-primary-100">
                <h3 class="font-semibold text-primary-950 mb-2 text-sm">{b.title}</h3>
                <p class="text-xs text-primary-900/50 leading-relaxed">{b.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Drie verplichtingen -->
    <section class="py-24 bg-gradient-to-b from-white to-primary-50/40">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">De wet in het kort</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
            Drie verplichtingen, <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">een aanpak</span>
          </h2>
          <p class="mt-4 text-lg text-primary-900/60 leading-relaxed">
            De Cyberbeveiligingswet draait om registreren, beveiligen en melden. De coach van Control One loopt ze alle drie met je door.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {verplichtingen.map((v, i) => (
            <div class="relative p-6 rounded-2xl border border-primary-100 bg-white shadow-sm hover:shadow-md hover:border-primary-200 transition-all">
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={v.icon}></path></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-primary-400 bg-primary-50 px-2 py-1 rounded-full">{i + 1}. {v.label}</span>
              </div>
              <h3 class="font-semibold text-primary-950 mb-2 leading-snug">{v.title}</h3>
              <p class="text-sm text-primary-900/50 leading-relaxed">{v.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 10 maatregelcategorieen -->
    <section class="py-24 bg-gradient-to-b from-primary-50/50 to-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-16">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Zorgplicht · artikel 21</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
            <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">De tien maatregelcategorieen</span>
          </h2>
          <p class="mt-4 text-lg text-primary-900/60">
            Artikel 21 lid 2 schrijft tien categorieen beveiligingsmaatregelen voor. In Control One werk je ze per categorie uit, met per maatregel de overeenkomstige ISO 27001:2022-maatregel erbij.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
          {categorieen.map(c => (
            <div class="flex items-start gap-3 p-4 rounded-2xl border border-primary-100 bg-white hover:border-primary-200 hover:shadow-md transition-all">
              <span class="shrink-0 mt-0.5 text-[11px] font-bold text-violet-700 bg-violet-50 border border-violet-100 rounded-md px-1.5 py-0.5">{c.number}</span>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-primary-950 leading-snug">{c.title}</p>
                <p class="mt-1 text-xs text-primary-900/50 leading-relaxed">{c.description}</p>
              </div>
            </div>
          ))}
          <!-- Extra card: ISO 27001-mapping -->
          <div class="relative p-5 rounded-2xl bg-gradient-to-br from-primary-700 to-primary-900 text-white overflow-hidden flex flex-col justify-between sm:col-span-2 lg:col-span-1">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
            <div class="relative">
              <div class="text-lg font-bold mb-2">Al ISO 27001?</div>
              <p class="text-primary-300/80 text-sm leading-relaxed">
                Elke NIS2-maatregel is gemapt op de overeenkomstige ISO 27001:2022-maatregel. Bestaande documentatie koppel je direct, zonder dubbel werk.
              </p>
            </div>
            <a href="/iso-27001" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-white/90 hover:text-white transition-colors">
              Bekijk ISO 27001
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Meldplicht tijdlijn -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-accent-600 mb-3">Meldplicht</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
            Drie deadlines <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">na een significant incident</span>
          </h2>
          <p class="mt-4 text-lg text-primary-900/60 leading-relaxed">
            De termijnen zijn strak. Met het incidentproces van Control One ligt de procedure klaar voordat je hem nodig hebt.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {meldplicht.map((m, i) => (
            <div class="relative p-6 rounded-2xl border border-primary-100 bg-gradient-to-br from-primary-50/60 to-white">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-primary-600 text-white flex items-center justify-center font-bold text-sm shrink-0">{i + 1}</div>
                <div class="text-2xl font-bold text-primary-950">{m.termijn}</div>
              </div>
              <h3 class="font-semibold text-primary-950 mb-2 leading-snug">{m.title}</h3>
              <p class="text-sm text-primary-900/50 leading-relaxed">{m.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Zo werkt het in de portal -->
    <section class="py-24 bg-gradient-to-b from-white to-primary-50/40">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-accent-600 mb-3">Het platform</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">
            Zo werkt NIS2 <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">in Control One</span>
          </h2>
          <p class="mt-4 text-lg text-primary-900/60 leading-relaxed">
            Vier modules waarmee je de zorgplicht uitwerkt, de keten beheerst en je verantwoording richting de toezichthouder opbouwt.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 max-w-5xl mx-auto">

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-dashboard.png" alt="Dashboard met voortgang op de NIS2-maatregelen in Control One" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-primary-700 shadow">Module · Dashboard</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Dashboard &amp; rapportage</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Realtime inzicht in de voortgang per maatregelcategorie en openstaande acties, ook op bestuursniveau. Het bestuur keurt goed en ziet waarvoor het tekent.</p>
            </div>
          </article>

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-risks.png" alt="Risicoanalyse volgens de all-hazards-benadering in Control One" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-accent-700 shadow">Module · Risicoanalyse</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Risicoanalyse</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Beoordeel risico's volgens de all-hazards-benadering die de wet vraagt en koppel maatregelen direct aan de tien categorieen van artikel 21.</p>
            </div>
          </article>

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-soa.png" alt="Maatregelenverantwoording per artikel 21-categorie in Control One" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-amber-700 shadow">Module · Verantwoording</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Maatregelenverantwoording</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Leg per maatregel vast of en hoe je die toepast, met onderbouwing. Dit is het dossier waarmee je je tegenover de toezichthouder verantwoordt.</p>
            </div>
          </article>

          <article class="group rounded-3xl border border-primary-100 bg-white overflow-hidden shadow-sm hover:shadow-xl hover:border-primary-200 transition-all duration-300">
            <div class="relative aspect-video bg-primary-50 overflow-hidden">
              <img src="/screenshots/portal-vendors.png" alt="Leveranciersbeheer voor de beveiliging van de toeleveringsketen" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" data-lightbox />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/95 backdrop-blur text-[10px] font-bold uppercase tracking-widest text-teal-700 shadow">Module · Toeleveringsketen</span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-primary-950 text-lg mb-1.5">Toeleveringsketen</h3>
              <p class="text-sm text-primary-900/60 leading-relaxed">Registreer leveranciers, classificeer ze op risico en volg certificaten en beoordelingen: precies wat categorie M4 van je vraagt.</p>
            </div>
          </article>

        </div>

        <div class="mt-12 text-center">
          <a href="/demo" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-primary-950 bg-accent-400 hover:bg-accent-300 rounded-xl transition-all shadow-lg">
            Bekijk de live demo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
