---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

// De volledige route van start tot certificaat. Elke fase heeft een 'owner':
// 'co' = jij doet het zelf in de Control One portal, 'cert' = de externe certificeerder.
const fases = [
  {
    num: '01',
    owner: 'co',
    fase: 'Voorbereiden',
    title: 'Norm, scope en nulmeting',
    desc: 'Je kiest de norm (bijvoorbeeld ISO 27001 of ISO 9001) en bepaalt de scope van je managementsysteem. De gratis quickscan laat direct zien waar je staat en hoe lang je traject duurt.',
    doet: ['Norm en scope vastleggen', 'Quickscan als nulmeting', 'Projectplanning opstellen'],
    shot: '/screenshots/portal-dashboard.png',
    shotAlt: 'Het dashboard in Control One met je voortgang per norm',
  },
  {
    num: '02',
    owner: 'co',
    fase: 'Implementeren',
    title: 'De implementatiecoach doorlopen',
    desc: 'De 28-stappen coach leidt je door de hele norm. Documenten staan al voor je klaar en vooringevuld: je hoeft ze alleen aan te vullen met je eigen situatie. Risico\'s en maatregelen leg je vast in de portal.',
    doet: ['Beleid en procedures uit sjablonen', 'Risicoanalyse en risicomatrix', 'Annex A-maatregelen invullen'],
    shot: '/screenshots/portal-coach.png',
    shotAlt: 'De implementatiecoach in Control One met stappen en checkvragen',
  },
  {
    num: '03',
    owner: 'co',
    fase: 'Toetsen',
    title: 'Interne audit en directiebeoordeling',
    desc: 'Voordat een certificeerder langskomt, toets je jezelf. De interne audit module loodst je door elke clausule, legt bevindingen vast en zet ze om in verbeteracties (CPAR\'s). De directiebeoordeling verzamelt automatisch alle vereiste input.',
    doet: ['Interne audit per hoofdstuk', 'Bevindingen omzetten in CPAR\'s', 'Directiebeoordeling afronden'],
    shot: '/screenshots/portal-audits.png',
    shotAlt: 'De interne audit module in Control One met bevindingen en CPARs',
  },
  {
    num: '04',
    owner: 'cert',
    fase: 'Certificeerder kiezen',
    title: 'Offertes bij een geaccrediteerde instelling',
    desc: 'Nu neem je contact op met een certificeerder. Vraag bij een paar RvA-geaccrediteerde instellingen een offerte op met dezelfde scope-informatie. Alleen een geaccrediteerd certificaat wordt door opdrachtgevers en tenders erkend.',
    doet: ['Minimaal drie offertes vergelijken', 'Auditdatum vastleggen', 'Scope en fte doorgeven'],
  },
  {
    num: '05',
    owner: 'cert',
    fase: 'Stage 1-audit',
    title: 'Documentatie-audit door de certificeerder',
    desc: 'De certificeerder controleert of je managementsysteem op papier compleet is: beleid, risicoanalyse, Verklaring van Toepasselijkheid, interne audit en directiebeoordeling. Alles wat je in de portal hebt opgebouwd komt hier samen.',
    doet: ['Documentatie beoordelen', 'Reikwijdte bevestigen', 'Eventuele hiaten benoemen'],
  },
  {
    num: '06',
    owner: 'cert',
    fase: 'Stage 2-audit',
    title: 'Implementatie-audit en het certificaat',
    desc: 'De certificeerder toetst of je in de praktijk doet wat je hebt vastgelegd, door interviews en steekproeven. Zijn er geen grote afwijkingen, dan volgt je certificaat. Het certificaat is drie jaar geldig.',
    doet: ['Implementatie in de praktijk toetsen', 'Non-conformiteiten afhandelen', 'Certificaat toekennen'],
  },
  {
    num: '07',
    owner: 'co',
    fase: 'Onderhouden',
    title: 'Surveillance en hercertificering',
    desc: 'Een certificaat is geen eindpunt. Elk jaar volgt een controle-audit (surveillance) en na drie jaar een volledige hercertificering. De portal houdt je auditplanning, documenten en acties het hele jaar door actueel.',
    doet: ['Jaarlijkse controle-audit', 'Continu verbeteren via CPAR\'s', 'Hercertificering na 3 jaar'],
    shot: '/screenshots/portal-documents.png',
    shotAlt: 'Documentbeheer in Control One met versies en revisiedata',
  },
];

// Duidelijke scheiding: wat regelt de portal, wat doet de certificeerder.
const controlOneDoet = [
  { title: 'Stap-voor-stap implementeren', desc: 'De 28-stappen coach vertaalt de norm naar concrete taken, zodat je niets over het hoofd ziet.' },
  { title: 'Documenten vooringevuld', desc: '120+ sjablonen staan klaar en zijn al ingevuld met de standaardsituatie. Jij vult alleen je eigen gegevens aan.' },
  { title: 'Risico\'s en maatregelen', desc: 'Risicoregister, risicomatrix en alle Annex A-maatregelen met status, eigenaar en koppeling aan documenten.' },
  { title: 'Interne audit module', desc: 'Voer je verplichte interne audit zelf uit, leg bevindingen vast en zet ze om in verbeteracties.' },
  { title: 'Directiebeoordeling', desc: 'De portal verzamelt automatisch alle input die de norm voor de management review vereist.' },
  { title: 'Auditklaar dossier', desc: 'Alles staat op één plek. Tijdens Stage 1 en Stage 2 geef je de certificeerder simpelweg toegang tot je dossier.' },
];

const certificeerderDoet = [
  { title: 'Onafhankelijke toetsing', desc: 'Een certificeerder moet volledig onafhankelijk zijn. Daarom mag de partij die je begeleidt niet ook certificeren.' },
  { title: 'Stage 1: documentatie', desc: 'Beoordeelt of je managementsysteem op papier compleet en normconform is.' },
  { title: 'Stage 2: implementatie', desc: 'Toetst via interviews en steekproeven of je in de praktijk werkt zoals je beschrijft.' },
  { title: 'Het certificaat uitgeven', desc: 'Alleen een RvA-geaccrediteerde certificeerder mag een erkend ISO-certificaat afgeven.' },
  { title: 'Surveillance-audits', desc: 'Voert de jaarlijkse controle-audits uit gedurende de looptijd van je certificaat.' },
  { title: 'Hercertificering', desc: 'Voert na drie jaar de volledige hercertificeringsaudit uit voor een nieuwe cyclus.' },
];

// Zes grote, RvA-geaccrediteerde certificeerders in Nederland (voorbeelden).
const certificeerders = [
  { naam: 'DNV', logo: '/logos/certificeerders/dnv.svg', h: 'max-h-9', omschrijving: 'Wereldwijde certificeerder, sterk in informatiebeveiliging en kwaliteit.', url: 'https://www.dnv.nl' },
  { naam: 'Kiwa', logo: '/logos/certificeerders/kiwa.svg', h: 'max-h-9', omschrijving: 'Nederlandse instelling met een breed aanbod aan managementsysteemcertificering.', url: 'https://www.kiwa.com/nl/nl/' },
  { naam: 'Bureau Veritas', logo: '/logos/certificeerders/bureau-veritas.png', h: 'max-h-16', omschrijving: 'Een van de grootste certificeerders ter wereld, actief in de hele Benelux.', url: 'https://benelux.bureauveritas.com' },
  { naam: 'LRQA', logo: '/logos/certificeerders/lrqa.png', h: 'max-h-8', omschrijving: 'Voorheen Lloyd\'s Register, gespecialiseerd in ISO-managementsystemen.', url: 'https://www.lrqa.com/nl-nl/' },
  { naam: 'DEKRA', logo: '/logos/certificeerders/dekra.svg', h: 'max-h-9', omschrijving: 'Sterk in techniek, veiligheid en informatiebeveiliging.', url: 'https://www.dekra.nl' },
  { naam: 'TÜV NORD', logo: '/logos/certificeerders/tuv-nord.svg', h: 'max-h-10', omschrijving: 'Nederlandse certificeerder voor uiteenlopende ISO-normen.', url: 'https://www.tuv.nl' },
];

// De driejarige certificeringscyclus na het behalen van het certificaat.
const cyclus = [
  { jaar: 'Jaar 0', titel: 'Certificaat behaald', desc: 'Na een geslaagde Stage 1- en Stage 2-audit ontvang je het certificaat.', type: 'start' },
  { jaar: 'Jaar 1', titel: 'Controle-audit', desc: 'Kortere surveillance-audit op een deel van de norm.', type: 'controle' },
  { jaar: 'Jaar 2', titel: 'Controle-audit', desc: 'Opnieuw een surveillance-audit op een ander deel van de norm.', type: 'controle' },
  { jaar: 'Jaar 3', titel: 'Hercertificering', desc: 'Volledige audit. Daarna begint de cyclus opnieuw.', type: 'her' },
];

const faqs = [
  {
    vraag: 'Certificeert Control One mijn organisatie?',
    antwoord: 'Nee. Control One is een softwareplatform dat je door het hele traject begeleidt, maar geeft zelf geen certificaat af. Het certificaat wordt uitgegeven door een onafhankelijke, RvA-geaccrediteerde certificeerder. Dat is een wettelijke eis: de partij die je begeleidt mag je niet ook toetsen.',
  },
  {
    vraag: 'Wanneer moet ik contact opnemen met een certificeerder?',
    antwoord: 'Zodra je startdatum bekend is. Reken op 4 tot 8 weken wachttijd voor de eerste audit, dus het loont om vroeg offertes op te vragen en een auditdatum vast te leggen. Die datum werkt bovendien als gezonde deadline voor je traject.',
  },
  {
    vraag: 'Wat is het verschil tussen een Stage 1- en Stage 2-audit?',
    antwoord: 'De Stage 1-audit is een documentatie-audit: de certificeerder controleert of je managementsysteem op papier compleet is. De Stage 2-audit is een implementatie-audit: er wordt via interviews en steekproeven getoetst of je in de praktijk doet wat je hebt vastgelegd. Na een geslaagde Stage 2 volgt het certificaat.',
  },
  {
    vraag: 'Heb ik nog een externe consultant nodig?',
    antwoord: 'Voor de meeste MKB-organisaties niet. De portal begeleidt je zelfstandig door de implementatie en de interne audit. Wil je toch sparren of extra zekerheid, dan kun je onze consultancy inschakelen. De certificering zelf blijft altijd bij een onafhankelijke certificeerder.',
  },
  {
    vraag: 'Is elk ISO-certificaat evenveel waard?',
    antwoord: 'Ja, zolang de certificeerder geaccrediteerd is door de Raad voor Accreditatie (RvA) of een buitenlandse zusterorganisatie. De RvA borgt dat alle instellingen tegen dezelfde eisen toetsen. Prijsverschillen zitten in tarieven en planning, niet in de waarde van het certificaat.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://control-one.nl' },
    { '@type': 'ListItem', position: 2, name: 'Certificeringsproces', item: 'https://control-one.nl/certificeringsproces' },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Het ISO-certificeringsproces met Control One',
  description: 'Van voorbereiding tot certificaat: de zeven fasen van een ISO-certificeringstraject, waarbij je alles zelf doet in de Control One portal en alleen de audit door een externe certificeerder laat uitvoeren.',
  step: fases.map((f, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: f.title,
    text: f.desc,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
};
---

<Layout
  title="Het certificeringsproces — van start tot ISO-certificaat | Control One"
  description="Zo werkt ISO-certificering met Control One: je doet alles zelf in de portal (implementatie, interne audit, directiebeoordeling) en laat alleen de audit uitvoeren door een onafhankelijke certificeerder. Inclusief de grootste certificeerders van Nederland."
  jsonLd={[breadcrumbSchema, howToSchema, faqSchema]}
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="relative pt-32 pb-20 lg:pb-28 overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #0e2470 0%, #196bd7 65%, #2d5fa8 100%);"></div>
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-400/10 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6">
        <div class="lg:grid lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:items-center">
          <div class="max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-6 text-xs font-semibold tracking-widest uppercase text-accent-400 bg-accent-400/10 rounded-full border border-accent-400/20">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Certificeringsproces
            </div>
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white leading-[1.1]">
              Van start tot certificaat,<br/><span class="text-accent-400">stap voor stap</span>
            </h1>
            <p class="mt-6 text-lg text-primary-200/90 leading-relaxed">
              Met Control One doe je vrijwel alles zelf: implementeren, documenteren en zelfs je interne audit. Op één moment schakel je een onafhankelijke certificeerder in voor de audit. Zo ziet dat hele traject eruit.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-xs font-medium text-white/80">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Zelf te doen in de portal
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Interne audit ingebouwd
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Onafhankelijk certificaat
              </div>
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/quickscan" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-primary-950 bg-accent-400 hover:bg-accent-300 rounded-lg transition-all shadow-lg">
                Doe de gratis quickscan
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </a>
              <a href="#certificeerders" class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white border border-white/20 hover:border-white/40 hover:bg-white/5 rounded-lg transition-all">Bekijk certificeerders</a>
            </div>
          </div>

          <!-- Hero-visual: interne audit module -->
          <div class="mt-12 lg:mt-0">
            <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/40">
              <div class="flex items-center gap-3 px-4 py-2.5 bg-primary-50 border-b border-primary-100">
                <div class="flex gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-red-400/60"></span><span class="w-2.5 h-2.5 rounded-full bg-amber-400/60"></span><span class="w-2.5 h-2.5 rounded-full bg-green-400/60"></span></div>
                <div class="flex-1 min-w-0 max-w-[220px] mx-auto"><div class="bg-white/80 rounded px-3 py-0.5 text-xs text-primary-400 border border-primary-100 text-center truncate">app.control-one.nl/audits</div></div>
              </div>
              <img src="/screenshots/portal-audits.png" alt="De interne audit module in Control One" class="w-full" loading="eager" data-lightbox />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Kernboodschap: wij begeleiden, wij certificeren niet -->
    <section class="py-16 bg-white border-b border-primary-100/60">
      <div class="max-w-5xl mx-auto px-6">
        <div class="rounded-3xl border border-primary-100 bg-gradient-to-br from-primary-50/70 to-white overflow-hidden">
          <div class="grid lg:grid-cols-[0.7fr_1fr] items-stretch">

            <!-- Foto -->
            <div class="relative h-56 sm:h-72 lg:h-auto lg:min-h-[340px]">
              <img
                src="/team/office-5.webp"
                alt="Twee collega's van Control One kijken samen mee op een scherm"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary-950/25 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-primary-50/40 pointer-events-none"></div>
            </div>

            <!-- Tekst -->
            <div class="p-7 sm:p-10 flex flex-col justify-center">
              <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-5">
                <div class="w-12 h-12 rounded-2xl bg-accent-400/15 text-accent-500 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                </div>
                <div>
                  <h2 class="text-2xl sm:text-3xl font-bold text-primary-950 tracking-tight">Wij begeleiden, een certificeerder toetst</h2>
                  <p class="mt-3 text-base sm:text-lg text-primary-900/75 leading-relaxed">
                    Control One brengt je volledig auditklaar. Maar het certificaat zelf geven wij bewust niet af. Een ISO-certificaat mag alleen worden uitgegeven door een onafhankelijke, geaccrediteerde certificeerder. Dat is juist je garantie: de partij die je toetst, is niet dezelfde partij die je heeft geholpen. Zo blijft je certificaat objectief en overal erkend.
                  </p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Het proces: 7 fasen als verticale timeline -->
    <section class="py-24 bg-gradient-to-b from-primary-50/40 to-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Het hele traject</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">Zeven fasen naar je <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">certificaat</span></h2>
          <p class="mt-4 text-lg text-primary-900/75">De eerste drie fasen doorloop je zelf in de portal. Daarna komt de certificeerder in beeld. Na je certificaat houd je alles moeiteloos actueel.</p>
        </div>

        <!-- Legenda -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent-400/10 text-primary-700 border border-accent-400/30">
            <span class="w-2.5 h-2.5 rounded-full bg-accent-500"></span>
            Jij, met de Control One portal
          </span>
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            De externe certificeerder
          </span>
        </div>

        <ol class="relative max-w-3xl mx-auto border-l-2 border-primary-100 pl-8 sm:pl-10 space-y-6">
          {fases.map(f => (
            <li class="relative">
              <div class:list={[
                'absolute top-1 flex items-center justify-center w-11 h-11 rounded-2xl font-bold text-sm shadow-md ring-4 ring-white -left-[calc(1.375rem+2px)] sm:-left-[calc(1.375rem+2px)]',
                f.owner === 'co' ? 'bg-gradient-to-br from-primary-600 to-accent-500 text-white' : 'bg-gradient-to-br from-amber-400 to-amber-600 text-white',
              ]}>{f.num}</div>
              <div class:list={[
                'ml-4 sm:ml-6 p-6 rounded-2xl border bg-white transition-all hover:shadow-lg',
                f.owner === 'co' ? 'border-primary-100 hover:shadow-primary-100/50' : 'border-amber-100 hover:shadow-amber-100/50',
              ]}>
                <div class="flex items-center gap-3 flex-wrap mb-2">
                  <span class:list={[
                    'text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full border',
                    f.owner === 'co' ? 'bg-accent-400/10 text-primary-700 border-accent-400/30' : 'bg-amber-50 text-amber-800 border-amber-200',
                  ]}>{f.owner === 'co' ? 'In de portal' : 'Certificeerder'}</span>
                  <span class="text-xs font-semibold text-primary-500">{f.fase}</span>
                </div>
                <h3 class="text-lg font-bold text-primary-950">{f.title}</h3>
                <div class="lg:flex lg:gap-6 lg:items-start">
                  <div class="lg:flex-1 lg:min-w-0">
                    <p class="mt-2 text-sm text-primary-900/70 leading-relaxed">{f.desc}</p>
                    <ul class:list={['mt-4 grid gap-2', f.shot ? 'sm:grid-cols-2' : 'sm:grid-cols-3']}>
                      {f.doet.map(d => (
                        <li class="flex items-start gap-1.5 text-xs text-primary-900/75">
                          <svg class:list={['w-3.5 h-3.5 shrink-0 mt-0.5', f.owner === 'co' ? 'text-accent-500' : 'text-amber-500']} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                          <span>{d}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  {f.shot && (
                    <div class="mt-5 lg:mt-2 lg:w-56 lg:shrink-0">
                      <div class="rounded-xl overflow-hidden border border-primary-100 shadow-md shadow-primary-100/50 bg-white">
                        <div class="flex items-center gap-1 px-2 py-1.5 bg-primary-50 border-b border-primary-100">
                          <span class="w-1.5 h-1.5 rounded-full bg-red-400/60"></span>
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400/60"></span>
                          <span class="w-1.5 h-1.5 rounded-full bg-green-400/60"></span>
                        </div>
                        <div class="max-h-44 overflow-hidden">
                          <img src={f.shot} alt={f.shotAlt} loading="lazy" class="w-full" data-lightbox />
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Wie doet wat: split -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-12">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Rolverdeling</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">Wie doet <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">wat?</span></h2>
          <p class="mt-4 text-lg text-primary-900/75">Het overgrote deel van het werk regel je zelf in de portal. De certificeerder komt pas aan het eind in beeld, voor de onafhankelijke toetsing.</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
          <!-- Control One -->
          <div class="rounded-3xl border-2 border-accent-400/30 bg-gradient-to-b from-accent-400/5 to-white p-7 sm:p-8">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-11 h-11 rounded-2xl bg-white border border-primary-100 shadow-sm flex items-center justify-center shrink-0 p-1.5">
                <img src="/favicon.svg" alt="Control One" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-primary-500">In de portal</p>
                <h3 class="text-xl font-bold text-primary-950">Control One doet dit voor je</h3>
              </div>
            </div>
            <ul class="space-y-3.5">
              {controlOneDoet.map(item => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full bg-accent-400/15 text-accent-500 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-primary-950">{item.title}</p>
                    <p class="text-xs text-primary-900/65 leading-relaxed mt-0.5">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Certificeerder -->
          <div class="rounded-3xl border-2 border-amber-200 bg-gradient-to-b from-amber-50/60 to-white p-7 sm:p-8">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 text-white flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-amber-700">Onafhankelijk</p>
                <h3 class="text-xl font-bold text-primary-950">De certificeerder doet dit</h3>
              </div>
            </div>
            <ul class="space-y-3.5">
              {certificeerderDoet.map(item => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-primary-950">{item.title}</p>
                    <p class="text-xs text-primary-900/65 leading-relaxed mt-0.5">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlight: interne audit module als voorbereiding -->
    <section class="py-24 bg-primary-50/30">
      <div class="max-w-6xl mx-auto px-6">
        <div class="lg:grid lg:grid-cols-2 lg:gap-14 lg:items-center">
          <div>
            <p class="text-sm font-semibold tracking-wide uppercase text-orange-600 mb-3">Het scharnierpunt</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">De interne audit module brengt je <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">auditklaar</span></h2>
            <p class="mt-5 text-lg text-primary-900/75 leading-relaxed">
              Voordat de certificeerder langskomt, verplicht elke ISO-norm een eigen interne audit en een directiebeoordeling. Precies daar helpt de portal je het meest: je toetst jezelf op dezelfde punten als de certificeerder, zodat er tijdens de externe audit geen verrassingen zijn.
            </p>
            <ul class="mt-7 space-y-3.5">
              {[
                'De module loodst je per hoofdstuk en maatregel door de norm.',
                'Bevindingen worden direct verbeteracties (CPAR\'s) met eigenaar en deadline.',
                'De directiebeoordeling verzamelt automatisch alle vereiste input.',
                'Je exporteert een compleet auditrapport als PDF voor de certificeerder.',
              ].map(t => (
                <li class="flex items-start gap-3 text-primary-900/80">
                  <span class="w-6 h-6 rounded-full bg-orange-50 border border-orange-200 text-orange-600 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  </span>
                  <span class="text-sm sm:text-base leading-relaxed">{t}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <a href="/audits" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-primary-950 bg-accent-400 hover:bg-accent-500 hover:text-white rounded-xl transition-all shadow-lg shadow-accent-500/25">
                Bekijk de audit module
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </a>
            </div>
          </div>

          <div class="mt-12 lg:mt-0">
            <div class="rounded-2xl overflow-hidden border border-primary-100 shadow-2xl shadow-primary-100/50 bg-white">
              <div class="flex items-center gap-3 px-4 py-2.5 bg-primary-50 border-b border-primary-100">
                <div class="flex gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-red-400/60"></span><span class="w-2.5 h-2.5 rounded-full bg-amber-400/60"></span><span class="w-2.5 h-2.5 rounded-full bg-green-400/60"></span></div>
                <div class="flex-1 min-w-0 max-w-[220px] mx-auto"><div class="bg-white/80 rounded px-3 py-0.5 text-xs text-primary-400 border border-primary-100 text-center truncate">app.control-one.nl/directiebeoordeling</div></div>
              </div>
              <img src="/screenshots/portal-directie.png" alt="De directiebeoordeling in Control One" class="w-full" loading="lazy" data-lightbox />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Certificeringscyclus van 3 jaar -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-14">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Na je certificaat</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">De cyclus van <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">drie jaar</span></h2>
          <p class="mt-4 text-lg text-primary-900/75">Een ISO-certificaat is drie jaar geldig. In die periode komt de certificeerder jaarlijks langs voor een kortere controle-audit. De portal houdt je dossier het hele jaar door actueel.</p>
        </div>

        <div class="relative max-w-5xl mx-auto">
          <!-- Verbindingslijn (desktop) -->
          <div class="hidden md:block absolute top-7 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-accent-400 via-primary-300 to-amber-400"></div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-4 relative">
            {cyclus.map(c => (
              <div class="flex md:flex-col items-start md:items-center gap-4 md:gap-0 md:text-center">
                <div class:list={[
                  'w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-md ring-4 ring-white relative z-10',
                  c.type === 'start' ? 'bg-gradient-to-br from-primary-600 to-accent-500 text-white' :
                  c.type === 'her' ? 'bg-gradient-to-br from-amber-400 to-amber-600 text-white' :
                  'bg-white border-2 border-primary-200 text-primary-600',
                ]}>
                  {c.type === 'start' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0"/></svg>
                  )}
                  {c.type === 'controle' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                  )}
                  {c.type === 'her' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
                  )}
                </div>
                <div class="md:mt-4">
                  <p class:list={['text-[10px] font-bold uppercase tracking-widest mb-1', c.type === 'her' ? 'text-amber-700' : 'text-primary-500']}>{c.jaar}</p>
                  <p class="text-base font-bold text-primary-950">{c.titel}</p>
                  <p class="mt-1 text-xs text-primary-900/65 leading-relaxed md:px-2">{c.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 flex items-center justify-center">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold text-primary-700 bg-primary-50 border border-primary-100">
              <svg class="w-4 h-4 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
              Na de hercertificering start de cyclus opnieuw
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Certificeerders -->
    <section id="certificeerders" class="py-24 bg-primary-50/30 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center mb-12">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Certificeerders</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">De grootste certificeerders <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">van Nederland</span></h2>
          <p class="mt-4 text-lg text-primary-900/75">Zes bekende, RvA-geaccrediteerde instellingen waar je terechtkunt voor de externe audit. Vraag bij een paar een offerte op en vergelijk op accreditatie, planning, branchekennis en prijs.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
          {certificeerders.map(c => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="group p-6 rounded-2xl border border-primary-100 bg-white hover:border-accent-400/50 hover:shadow-lg hover:shadow-primary-100/50 transition-all flex flex-col">
              <h3 class="sr-only">{c.naam}</h3>
              <div class="h-16 flex items-center mb-4">
                <img src={c.logo} alt={`Logo ${c.naam}`} loading="lazy" class:list={['w-auto max-w-[150px] object-contain object-left', c.h]} />
              </div>
              <p class="text-sm text-primary-900/70 leading-relaxed flex-1">{c.omschrijving}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 group-hover:text-accent-500 transition-colors">
                Bezoek website
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
              </span>
            </a>
          ))}
        </div>

        <div class="mt-10 max-w-3xl mx-auto p-5 rounded-2xl bg-primary-50/60 border border-primary-100 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold text-primary-950 mb-0.5">Let altijd op de accreditatie</p>
            <p class="text-xs text-primary-900/70 leading-relaxed">Kies alleen een instelling die door de <a href="https://www.rva.nl/managementsysteemcertificatie-instellingen/" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary-700 underline decoration-primary-300 underline-offset-2 hover:text-accent-500">Raad voor Accreditatie (RvA)</a> is geaccrediteerd voor jouw norm. Alleen dan is je certificaat overal erkend. Op de website van de RvA vind je de volledige, dagelijks bijgewerkte lijst.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-wide uppercase text-primary-600 mb-3">Veelgestelde vragen</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-primary-950 tracking-tight">Over het <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #0e2470 0%, #196bd7 50%, #01a2e8 100%);">certificeringsproces</span></h2>
        </div>
        <div class="space-y-3">
          {faqs.map(f => (
            <details class="group rounded-2xl border border-primary-100 bg-white overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 hover:bg-primary-50/40 transition-colors">
                <span class="text-base font-semibold text-primary-950">{f.vraag}</span>
                <svg class="w-5 h-5 text-primary-400 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </summary>
              <div class="px-6 pb-5 -mt-1">
                <p class="text-sm text-primary-900/75 leading-relaxed">{f.antwoord}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
